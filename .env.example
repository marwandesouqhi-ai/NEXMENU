# Environment Variables
# Copy this file to .env.local for local development.
# NEVER commit your actual .env file.

# ─────────────────────────────────────────────
# App
# ─────────────────────────────────────────────

# Public URL used to generate QR code links (e.g. https://yourapp.vercel.app)
# Defaults to window.location.origin at runtime when not set.
VITE_APP_ORIGIN=

# Base URL path for the app when deployed at a sub-path (e.g. /nexmenu)
# Leave empty for root-path deployments.
VITE_BASE_URL=

# Dev server bind host. Default: localhost
# Set to 0.0.0.0 to expose on the network (e.g. for mobile testing).
VITE_HOST=localhost

# ─────────────────────────────────────────────
# Phase 7 (Supabase backend — not yet active)
# Uncomment and populate only after Phase 7 approval.
# ─────────────────────────────────────────────

# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=
# VITE_DATA_ADAPTER=local       # 'local' (default) | 'supabase'
