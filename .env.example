# ==============================================================================
# NEXMENU — Environment Configuration Template
# Copy this file to .env.local for local development.
# NEVER commit your actual .env or .env.local file.
# ==============================================================================

# ──────────────────────────────────────────────────────────────────────────────
# Application Target & Deployment
# ──────────────────────────────────────────────────────────────────────────────
# Target build selector: 'all' (default dev & tests) | 'public' | 'admin'
VITE_APP_TARGET=all

# Canonical site origin used for metadata, sitemap, and SEO
VITE_SITE_URL=https://nexmenu.app

# Public menu origin used when generating QR codes and external links from admin
VITE_PUBLIC_SITE_URL=https://nexmenu.app

# ──────────────────────────────────────────────────────────────────────────────
# Data Adapter Configuration
# ──────────────────────────────────────────────────────────────────────────────
# Data adapter: 'local' (IndexedDB, offline-first) | 'supabase' (Cloud PostgreSQL)
VITE_DATA_ADAPTER=local

# Supabase Production / Staging Project Credentials (Client-Safe)
# DO NOT place service_role keys here.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-or-anon-key
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# ──────────────────────────────────────────────────────────────────────────────
# Dedicated RLS Test Credentials (TEST ONLY)
# ──────────────────────────────────────────────────────────────────────────────
# Used exclusively by 'pnpm test:rls' to verify multi-tenant isolation.
# MUST NOT equal VITE_SUPABASE_URL. Never point to your production database.
RLS_TEST_SUPABASE_URL=
RLS_TEST_SUPABASE_ANON_KEY=
